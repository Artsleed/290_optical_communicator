/*
  Fast 850nm IR Laser Detector Test
  Low delay with noise filtering
*/

const int DETECTOR_PIN = 2;
const int LASER_PIN = 9;
const int STATUS_LED = LED_BUILTIN;

const int DETECTED_LEVEL = LOW;

// Timing settings (milliseconds)
const unsigned long PHASE_MS = 100;
const unsigned long SETTLE_MS = 10;

// Detection thresholds (%)
const int DETECT_THRESHOLD = 80;
const int NO_DETECT_THRESHOLD = 20;

void setup() {
  Serial.begin(115200);

  pinMode(DETECTOR_PIN, INPUT_PULLUP);
  pinMode(LASER_PIN, OUTPUT);
  pinMode(STATUS_LED, OUTPUT);

  digitalWrite(LASER_PIN, LOW);
  digitalWrite(STATUS_LED, LOW);

  Serial.println("Fast 850nm IR Laser Test");
}

void testLaser(bool laserOn) {

  unsigned long startTime = millis();

  digitalWrite(LASER_PIN, laserOn ? HIGH : LOW);

  delay(SETTLE_MS);

  unsigned int detectedCount = 0;
  unsigned int totalSamples = 0;

  while (millis() - startTime < PHASE_MS) {

    if (digitalRead(DETECTOR_PIN) == DETECTED_LEVEL) {
      detectedCount++;
    }

    totalSamples++;
    delay(1);
  }

  float detectionPercent =
    100.0 * detectedCount / totalSamples;

  Serial.print(laserOn ? "Laser ON  -> " :
                         "Laser OFF -> ");

  if (detectionPercent >= DETECT_THRESHOLD) {

    Serial.print("DETECTED");
    digitalWrite(STATUS_LED, HIGH);

    if (!laserOn) {
      Serial.print(" [UNEXPECTED]");
    }

  } else if (detectionPercent <= NO_DETECT_THRESHOLD) {

    Serial.print("NOT DETECTED");
    digitalWrite(STATUS_LED, LOW);

    if (laserOn) {
      Serial.print(" [UNEXPECTED]");
    }

  } else {

    Serial.print("UNSTABLE SIGNAL");
    digitalWrite(STATUS_LED, LOW);

  }

  Serial.print(" | Detection: ");
  Serial.print(detectionPercent, 1);
  Serial.println("%");
}

void loop() {
  testLaser(true);
  testLaser(false);
}
